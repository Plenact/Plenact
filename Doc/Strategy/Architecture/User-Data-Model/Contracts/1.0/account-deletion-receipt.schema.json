{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Supported Plenact User Data Model versions: 1.0. Final specification; runtime integration is separately tracked.",
  "$id": "urn:plenact:user-data:1.0:account-deletion-receipt",
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": "1.0"
    },
    "account_id": {
      "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
    },
    "operation_id": {
      "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
    },
    "accepted_at_utc": {
      "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/utc_timestamp"
    },
    "primary_delete_deadline_utc": {
      "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/utc_timestamp"
    },
    "backup_delete_deadline_utc": {
      "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/utc_timestamp"
    }
  },
  "required": [
    "protocol_version",
    "account_id",
    "operation_id",
    "accepted_at_utc",
    "primary_delete_deadline_utc",
    "backup_delete_deadline_utc"
  ],
  "additionalProperties": false
}
