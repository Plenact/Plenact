{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Supported Plenact User Data Model versions: 1.0. Final specification; runtime integration is separately tracked.",
  "$id": "urn:plenact:user-data:1.0:account-deletion-request",
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": "1.0"
    },
    "operation_id": {
      "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
    },
    "account_id": {
      "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
    },
    "confirmation": {
      "const": "DELETE_MY_CLOUD_DATA"
    }
  },
  "required": [
    "protocol_version",
    "operation_id",
    "account_id",
    "confirmation"
  ],
  "additionalProperties": false
}
