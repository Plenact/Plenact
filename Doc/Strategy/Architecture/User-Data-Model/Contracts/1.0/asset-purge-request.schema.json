{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Supported Plenact User Data Model versions: 1.0. Final specification; runtime integration is separately tracked.",
  "$id": "urn:plenact:user-data:1.0:asset-purge-request",
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": "1.0"
    },
    "workspace_id": {
      "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
    },
    "epoch": {
      "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
    },
    "operation_id": {
      "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
    },
    "asset_id": {
      "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
    },
    "asset_revision": {
      "$ref": "urn:plenact:user-data:1.0:protocol-types#/$defs/positive_counter"
    },
    "confirmation": {
      "const": "PURGE_UNREFERENCED_ASSET"
    },
    "accept_history_media_unavailable": {
      "const": true
    }
  },
  "required": [
    "protocol_version",
    "workspace_id",
    "epoch",
    "operation_id",
    "asset_id",
    "asset_revision",
    "confirmation",
    "accept_history_media_unavailable"
  ],
  "additionalProperties": false
}
