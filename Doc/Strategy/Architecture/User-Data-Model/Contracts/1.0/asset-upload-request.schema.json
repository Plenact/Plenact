{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Supported Plenact User Data Model versions: 1.0. Final specification; runtime integration is separately tracked.",
  "$id": "urn:plenact:user-data:1.0:asset-upload-request",
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": "1.0"
    },
    "workspace_id": {
      "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
    },
    "epoch": {
      "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
    },
    "asset_id": {
      "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
    },
    "asset_revision": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$"
    },
    "byte_length": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "protocol_version",
    "workspace_id",
    "epoch",
    "asset_id",
    "asset_revision",
    "byte_length",
    "sha256"
  ],
  "additionalProperties": false
}
