{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Supported Plenact User Data Model versions: 1.0. Final specification; runtime integration is separately tracked.",
  "$id": "urn:plenact:user-data:1.0:calendar-index",
  "title": "Calendar selection and cross-week checklist-link ownership",
  "type": "object",
  "properties": {
    "user_data_model_version": {
      "const": "1.0"
    },
    "payload_schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "calendar_index"
    },
    "id": {
      "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
    },
    "workspace_id": {
      "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
    },
    "payload": {
      "type": "object",
      "properties": {
        "source_store_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "first_weekday": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "current_week_start_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "format": "date"
        },
        "week_ids": {
          "type": "array",
          "items": {
            "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
          },
          "uniqueItems": true
        },
        "checklist_link_weeks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "checklist_item_id": {
                "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
              },
              "week_id": {
                "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
              }
            },
            "required": [
              "checklist_item_id",
              "week_id"
            ],
            "additionalProperties": false
          },
          "uniqueItems": true
        }
      },
      "required": [
        "source_store_version",
        "first_weekday",
        "current_week_start_date",
        "week_ids",
        "checklist_link_weeks"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "user_data_model_version",
    "payload_schema_version",
    "record_type",
    "id",
    "workspace_id",
    "payload"
  ],
  "additionalProperties": false
}
