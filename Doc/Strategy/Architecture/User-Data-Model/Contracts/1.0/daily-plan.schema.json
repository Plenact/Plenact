{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Supported Plenact User Data Model versions: 1.0. Final specification; runtime integration is separately tracked.",
  "$id": "urn:plenact:user-data:1.0:daily-plan",
  "title": "Daily intention, check-in history and evening review",
  "type": "object",
  "properties": {
    "user_data_model_version": {
      "const": "1.0"
    },
    "payload_schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "daily_plan"
    },
    "id": {
      "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
    },
    "workspace_id": {
      "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
    },
    "payload": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "format": "date"
        },
        "time_zone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "intention": {
          "type": "string"
        },
        "constraints": {
          "type": "string"
        },
        "concerns": {
          "type": "string"
        },
        "priorities": {
          "type": "array",
          "items": {
            "$ref": "urn:plenact:user-data:1.0:planning-types#/$defs/priority"
          }
        },
        "updated_at_utc": {
          "anyOf": [
            {
              "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/utc_timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "check_in": {
          "anyOf": [
            {
              "$ref": "urn:plenact:user-data:1.0:planning-types#/$defs/check_in"
            },
            {
              "type": "null"
            }
          ]
        },
        "check_ins": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "urn:plenact:user-data:1.0:planning-types#/$defs/check_in_entry"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "evening_review": {
          "anyOf": [
            {
              "$ref": "urn:plenact:user-data:1.0:planning-types#/$defs/evening_review"
            },
            {
              "type": "null"
            }
          ]
        },
        "vision_step": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            {
              "type": "null"
            }
          ]
        },
        "vision_completed_at_utc": {
          "anyOf": [
            {
              "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/utc_timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "date",
        "time_zone",
        "intention",
        "constraints",
        "concerns",
        "priorities",
        "updated_at_utc",
        "check_in",
        "check_ins",
        "evening_review",
        "vision_step",
        "vision_completed_at_utc"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "user_data_model_version",
    "payload_schema_version",
    "record_type",
    "id",
    "workspace_id",
    "payload"
  ],
  "additionalProperties": false
}
