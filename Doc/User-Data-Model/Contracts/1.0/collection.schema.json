{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Supported Plenact User Data Model versions: 1.0. Final specification; runtime integration is separately tracked.",
  "$id": "urn:plenact:user-data:1.0:collection",
  "title": "Complete Collection content document; bookmarks are separate personal selections",
  "type": "object",
  "properties": {
    "user_data_model_version": {
      "const": "1.0"
    },
    "payload_schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "collection"
    },
    "id": {
      "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
    },
    "workspace_id": {
      "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
    },
    "payload": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "list",
            "board"
          ]
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "color": {
          "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/color"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "archived": {
          "type": "boolean"
        },
        "board_appearance": {
          "anyOf": [
            {
              "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/board_appearance"
            },
            {
              "type": "null"
            }
          ]
        },
        "preferred_focused_list_id": {
          "anyOf": [
            {
              "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "list_ids": {
          "type": "array",
          "items": {
            "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "title",
        "kind",
        "icon",
        "color",
        "description",
        "archived",
        "board_appearance",
        "preferred_focused_list_id",
        "list_ids"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "user_data_model_version",
    "payload_schema_version",
    "record_type",
    "id",
    "workspace_id",
    "payload"
  ],
  "additionalProperties": false
}
