{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Supported Plenact User Data Model versions: 1.0. Final specification; runtime integration is separately tracked.",
  "$id": "urn:plenact:user-data:1.0:content-types",
  "title": "Nested portable content types; not a standalone user record",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "utc_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://[^\\s]+$"
    },
    "color": {
      "type": "object",
      "properties": {
        "red": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "green": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "blue": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "legacy_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "red",
        "green",
        "blue",
        "legacy_token"
      ],
      "additionalProperties": false
    },
    "remote_photo": {
      "type": "object",
      "properties": {
        "provider": {
          "const": "unsplash"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "image_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://[^\\s]+$"
        },
        "photographer": {
          "type": "string"
        },
        "profile_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://[^\\s]+$"
        },
        "download_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://[^\\s]+$"
        }
      },
      "required": [
        "provider",
        "id",
        "image_url",
        "photographer",
        "profile_url",
        "download_url"
      ],
      "additionalProperties": false
    },
    "surface": {
      "type": "object",
      "properties": {
        "material": {
          "enum": [
            "plain",
            "color",
            "gradient",
            "paper",
            "linen",
            "dots",
            "grid",
            "canvas",
            "photo",
            "unsplash"
          ]
        },
        "color": {
          "type": "string",
          "pattern": "^[0-9A-F]{6}$"
        },
        "secondary_color": {
          "type": "string",
          "pattern": "^[0-9A-F]{6}$"
        },
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "readability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "vertical_position": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "zoom": {
          "type": "number",
          "minimum": 1,
          "maximum": 2
        },
        "shows_in_previews": {
          "type": "boolean"
        },
        "photo_asset_id": {
          "anyOf": [
            {
              "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "remote_photo": {
          "anyOf": [
            {
              "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/remote_photo"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "material",
        "color",
        "secondary_color",
        "strength",
        "readability",
        "vertical_position",
        "zoom",
        "shows_in_previews",
        "photo_asset_id",
        "remote_photo"
      ],
      "additionalProperties": false
    },
    "collection_background": {
      "type": "object",
      "properties": {
        "preset": {
          "enum": [
            "linen",
            "sage",
            "ocean",
            "plum",
            "sandstone",
            "midnight",
            "photo",
            "tabletop",
            "forest_path",
            "sunlit_wall",
            "plain"
          ]
        },
        "photo_asset_id": {
          "anyOf": [
            {
              "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "preset",
        "photo_asset_id"
      ],
      "additionalProperties": false
    },
    "board_appearance": {
      "type": "object",
      "properties": {
        "banner_background": {
          "anyOf": [
            {
              "enum": [
                "teal",
                "blue",
                "purple",
                "rose",
                "orange",
                "green",
                "coral",
                "graphite"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "collection_background": {
          "anyOf": [
            {
              "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/collection_background"
            },
            {
              "type": "null"
            }
          ]
        },
        "list_background": {
          "anyOf": [
            {
              "enum": [
                "neutral",
                "blue",
                "green",
                "orange",
                "red"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "card_background": {
          "anyOf": [
            {
              "enum": [
                "neutral",
                "blue",
                "green",
                "orange",
                "red"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "card_detail": {
          "anyOf": [
            {
              "enum": [
                "compact",
                "detailed"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "card_title_color": {
          "anyOf": [
            {
              "enum": [
                "graphite",
                "blue",
                "teal",
                "green",
                "plum",
                "rose",
                "amber"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "card_text_color": {
          "anyOf": [
            {
              "enum": [
                "graphite",
                "blue",
                "teal",
                "green",
                "plum",
                "rose",
                "amber"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "add_item_text_color": {
          "anyOf": [
            {
              "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/color"
            },
            {
              "type": "null"
            }
          ]
        },
        "studio_surface": {
          "anyOf": [
            {
              "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/surface"
            },
            {
              "type": "null"
            }
          ]
        },
        "studio_card_surface": {
          "anyOf": [
            {
              "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/surface"
            },
            {
              "type": "null"
            }
          ]
        },
        "subtitle_italic": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "banner_background",
        "collection_background",
        "list_background",
        "card_background",
        "card_detail",
        "card_title_color",
        "card_text_color",
        "add_item_text_color",
        "studio_surface",
        "studio_card_surface",
        "subtitle_italic"
      ],
      "additionalProperties": false
    },
    "item_appearance": {
      "type": "object",
      "properties": {
        "accent": {
          "anyOf": [
            {
              "enum": [
                "teal",
                "blue",
                "purple",
                "rose",
                "orange",
                "green",
                "coral",
                "graphite"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "icon": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "background": {
          "anyOf": [
            {
              "enum": [
                "teal",
                "blue",
                "purple",
                "rose",
                "orange",
                "green",
                "coral",
                "graphite"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "list_background": {
          "anyOf": [
            {
              "enum": [
                "neutral",
                "blue",
                "green",
                "orange",
                "red"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "card_background": {
          "anyOf": [
            {
              "enum": [
                "neutral",
                "blue",
                "green",
                "orange",
                "red"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "card_detail": {
          "anyOf": [
            {
              "enum": [
                "compact",
                "detailed"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "card_title_color": {
          "anyOf": [
            {
              "enum": [
                "graphite",
                "blue",
                "teal",
                "green",
                "plum",
                "rose",
                "amber"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "card_text_color": {
          "anyOf": [
            {
              "enum": [
                "graphite",
                "blue",
                "teal",
                "green",
                "plum",
                "rose",
                "amber"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "add_item_text_color": {
          "anyOf": [
            {
              "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/color"
            },
            {
              "type": "null"
            }
          ]
        },
        "studio_surface": {
          "anyOf": [
            {
              "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/surface"
            },
            {
              "type": "null"
            }
          ]
        },
        "studio_card_surface": {
          "anyOf": [
            {
              "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/surface"
            },
            {
              "type": "null"
            }
          ]
        },
        "subtitle_italic": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "section_collapsed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "hide_empty_subtitle": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "list_view_mode": {
          "anyOf": [
            {
              "enum": [
                "cards",
                "note_list"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "icon_color": {
          "anyOf": [
            {
              "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/color"
            },
            {
              "type": "null"
            }
          ]
        },
        "shows_icon_in_header": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "list_background_opacity": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "accent",
        "icon",
        "background",
        "list_background",
        "card_background",
        "card_detail",
        "card_title_color",
        "card_text_color",
        "add_item_text_color",
        "studio_surface",
        "studio_card_surface",
        "subtitle_italic",
        "section_collapsed",
        "hide_empty_subtitle",
        "list_view_mode",
        "icon_color",
        "shows_icon_in_header",
        "list_background_opacity"
      ],
      "additionalProperties": false
    },
    "section_layout": {
      "type": "object",
      "properties": {
        "order": {
          "type": "array",
          "items": {
            "enum": [
              "quick_actions",
              "media",
              "description",
              "details",
              "checklists",
              "activity"
            ]
          },
          "uniqueItems": true
        },
        "hidden": {
          "type": "array",
          "items": {
            "enum": [
              "quick_actions",
              "media",
              "description",
              "details",
              "checklists",
              "activity"
            ]
          },
          "uniqueItems": true
        }
      },
      "required": [
        "order",
        "hidden"
      ],
      "additionalProperties": false
    },
    "comment": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
        },
        "author": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "source_created_at_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
        },
        "author_account_id": {
          "anyOf": [
            {
              "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "author",
        "body",
        "source_created_at_utc",
        "author_account_id"
      ],
      "additionalProperties": false
    },
    "reaction": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
        },
        "emoji": {
          "type": "string",
          "minLength": 1
        },
        "source_author_id": {
          "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
        },
        "source_created_at_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
        },
        "author_account_id": {
          "anyOf": [
            {
              "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "emoji",
        "source_author_id",
        "source_created_at_utc",
        "author_account_id"
      ],
      "additionalProperties": false
    },
    "assignee": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
            },
            "kind": {
              "const": "manual"
            },
            "user_id": {
              "type": "null"
            },
            "display_name": {
              "type": "string"
            },
            "identity_scope": {
              "const": "manual"
            }
          },
          "required": [
            "id",
            "kind",
            "user_id",
            "display_name",
            "identity_scope"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
            },
            "kind": {
              "const": "registered_user"
            },
            "user_id": {
              "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
            },
            "display_name": {
              "type": "string"
            },
            "identity_scope": {
              "enum": [
                "legacy_demo",
                "owner_account"
              ]
            }
          },
          "required": [
            "id",
            "kind",
            "user_id",
            "display_name",
            "identity_scope"
          ],
          "additionalProperties": false
        }
      ]
    },
    "action_detail": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
        },
        "description": {
          "type": "string"
        },
        "checklists": {
          "type": "array",
          "items": {
            "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/checklist"
          }
        },
        "comments": {
          "type": "array",
          "items": {
            "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/comment"
          }
        }
      },
      "required": [
        "id",
        "description",
        "checklists",
        "comments"
      ],
      "additionalProperties": false
    },
    "action_content": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "standard"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "linked_card"
            },
            "card_id": {
              "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
            }
          },
          "required": [
            "kind",
            "card_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "action_detail"
            },
            "detail": {
              "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/action_detail"
            }
          },
          "required": [
            "kind",
            "detail"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "web_link"
            },
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://[^\\s]+$"
            }
          },
          "required": [
            "kind",
            "url"
          ],
          "additionalProperties": false
        }
      ]
    },
    "checklist_item": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
        },
        "title": {
          "type": "string"
        },
        "completed": {
          "type": "boolean"
        },
        "content": {
          "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/action_content"
        },
        "retained_detail": {
          "anyOf": [
            {
              "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/action_detail"
            },
            {
              "type": "null"
            }
          ]
        },
        "retained_card_id": {
          "anyOf": [
            {
              "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "retained_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://[^\\s]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "linked_collection_id": {
          "anyOf": [
            {
              "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "title",
        "completed",
        "content",
        "retained_detail",
        "retained_card_id",
        "retained_url",
        "linked_collection_id"
      ],
      "additionalProperties": false
    },
    "checklist": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
        },
        "title": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/checklist_item"
          }
        }
      },
      "required": [
        "id",
        "title",
        "items"
      ],
      "additionalProperties": false
    },
    "attachment": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
        },
        "kind": {
          "enum": [
            "photo",
            "video",
            "audio",
            "link"
          ]
        },
        "asset_id": {
          "anyOf": [
            {
              "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://[^\\s]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_added_at_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
        },
        "example_image": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "drawing_asset_id": {
          "anyOf": [
            {
              "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
