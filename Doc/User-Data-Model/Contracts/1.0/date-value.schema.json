{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Supported Plenact User Data Model versions: 1.0. Final specification; runtime integration is separately tracked.",
  "title": "Plenact date value",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "date"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "format": "date"
        }
      },
      "required": [
        "kind",
        "date"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "time"
        },
        "time": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}$"
        }
      },
      "required": [
        "kind",
        "time"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "date_and_time"
        },
        "local_date_time": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}$"
        },
        "time_zone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "tzdb_version": {
          "type": "string",
          "pattern": "^[0-9]{4}[a-z]$"
        },
        "utc_instant": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
        },
        "utc_offset": {
          "type": "string",
          "pattern": "^[+-](?:[01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "occurrence": {
          "enum": [
            "unique",
            "first",
            "second"
          ]
        }
      },
      "required": [
        "kind",
        "local_date_time",
        "time_zone",
        "tzdb_version",
        "utc_instant",
        "utc_offset",
        "occurrence"
      ],
      "additionalProperties": false
    }
  ],
  "$id": "urn:plenact:user-data:1.0:date-value"
}
