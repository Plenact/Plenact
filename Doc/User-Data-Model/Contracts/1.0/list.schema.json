{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Supported Plenact User Data Model versions: 1.0. Final specification; runtime integration is separately tracked.",
  "$id": "urn:plenact:user-data:1.0:list",
  "title": "Complete List content document",
  "type": "object",
  "properties": {
    "user_data_model_version": {
      "const": "1.0"
    },
    "payload_schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "list"
    },
    "id": {
      "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
    },
    "workspace_id": {
      "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
    },
    "payload": {
      "type": "object",
      "properties": {
        "collection_id": {
          "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
        },
        "title": {
          "type": "string"
        },
        "subtitle_override": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "archived": {
          "type": "boolean"
        },
        "default_item_presentation": {
          "anyOf": [
            {
              "enum": [
                "card",
                "note"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "appearance": {
          "anyOf": [
            {
              "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/item_appearance"
            },
            {
              "type": "null"
            }
          ]
        },
        "card_ids": {
          "type": "array",
          "items": {
            "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
          },
          "uniqueItems": true
        },
        "archived_card_ids": {
          "type": "array",
          "items": {
            "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "collection_id",
        "title",
        "subtitle_override",
        "archived",
        "default_item_presentation",
        "appearance",
        "card_ids",
        "archived_card_ids"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "user_data_model_version",
    "payload_schema_version",
    "record_type",
    "id",
    "workspace_id",
    "payload"
  ],
  "additionalProperties": false
}
