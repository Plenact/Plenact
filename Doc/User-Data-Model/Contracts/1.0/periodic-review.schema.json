{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Supported Plenact User Data Model versions: 1.0. Final specification; runtime integration is separately tracked.",
  "$id": "urn:plenact:user-data:1.0:periodic-review",
  "title": "Private periodic reflection with separate starting/current objectives",
  "type": "object",
  "properties": {
    "user_data_model_version": {
      "const": "1.0"
    },
    "payload_schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "periodic_review"
    },
    "id": {
      "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
    },
    "workspace_id": {
      "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
    },
    "payload": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "pattern": "\\S"
        },
        "start_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "format": "date"
        },
        "end_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "format": "date"
        },
        "time_zone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "step": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "highlights": {
          "type": "string"
        },
        "learned": {
          "type": "string"
        },
        "direction": {
          "type": "string"
        },
        "risks": {
          "type": "string"
        },
        "starting_objectives": {
          "type": "array",
          "items": {
            "$ref": "urn:plenact:user-data:1.0:planning-types#/$defs/objective"
          }
        },
        "objectives": {
          "type": "array",
          "items": {
            "$ref": "urn:plenact:user-data:1.0:planning-types#/$defs/objective"
          }
        },
        "priorities": {
          "type": "array",
          "items": {
            "$ref": "urn:plenact:user-data:1.0:planning-types#/$defs/priority"
          }
        },
        "updated_at_utc": {
          "anyOf": [
            {
              "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/utc_timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "completed_at_utc": {
          "anyOf": [
            {
              "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/utc_timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "title",
        "start_date",
        "end_date",
        "time_zone",
        "step",
        "highlights",
        "learned",
        "direction",
        "risks",
        "starting_objectives",
        "objectives",
        "priorities",
        "updated_at_utc",
        "completed_at_utc"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "user_data_model_version",
    "payload_schema_version",
    "record_type",
    "id",
    "workspace_id",
    "payload"
  ],
  "additionalProperties": false
}
