{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Supported Plenact User Data Model versions: 1.0. Final specification; runtime integration is separately tracked.",
  "$id": "urn:plenact:user-data:1.0:planning-template",
  "title": "Independent template-owned Collection and source-day mappings",
  "type": "object",
  "properties": {
    "user_data_model_version": {
      "const": "1.0"
    },
    "payload_schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "planning_template"
    },
    "id": {
      "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
    },
    "workspace_id": {
      "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
    },
    "payload": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "day",
            "week"
          ]
        },
        "anchor_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "format": "date"
        },
        "time_zone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "first_weekday": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "collection_id": {
          "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
        },
        "weekdays": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "weekday": {
                "type": "integer",
                "minimum": 1,
                "maximum": 7
              },
              "list_id": {
                "$ref": "urn:plenact:user-data:1.0:content-types#/$defs/uuid"
              }
            },
            "required": [
              "weekday",
              "list_id"
            ],
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "example_focus": {
          "anyOf": [
            {
              "$ref": "urn:plenact:user-data:1.0:planning-types#/$defs/example_focus"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "kind",
        "anchor_date",
        "time_zone",
        "first_weekday",
        "collection_id",
        "weekdays",
        "example_focus"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "user_data_model_version",
    "payload_schema_version",
    "record_type",
    "id",
    "workspace_id",
    "payload"
  ],
  "additionalProperties": false
}
