{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Supported Plenact User Data Model versions: 1.0. Final specification; runtime integration is separately tracked.",
  "$id": "urn:plenact:user-data:1.0:rich-text-runs",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "text": {
        "type": "string"
      },
      "bold": {
        "type": "boolean"
      },
      "italic": {
        "type": "boolean"
      },
      "color": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "fontName": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "fontSize": {
        "anyOf": [
          {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 512
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "text",
      "bold",
      "italic"
    ],
    "additionalProperties": false
  }
}
